{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile and display preferences for BudStack AI.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "User full display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User email address.",
          "minLength": 3,
          "maxLength": 254
        },
        "preferredCurrency": {
          "type": "string",
          "description": "Preferred currency display code.",
          "enum": ["INR", "USD", "EUR", "GBP"],
          "minLength": 3,
          "maxLength": 3
        },
        "theme": {
          "type": "string",
          "description": "UI color theme preference.",
          "enum": ["light", "dark"],
          "minLength": 4,
          "maxLength": 5
        },
        "notificationsEnabled": {
          "type": "boolean",
          "description": "Whether budget threshold notifications are active."
        },
        "budgetAlertThreshold": {
          "type": "integer",
          "description": "Budget utilization alert threshold percentage (50 to 100)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the user profile was last updated."
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "preferredCurrency",
        "theme",
        "notificationsEnabled",
        "budgetAlertThreshold",
        "createdAt",
        "updatedAt"
      ]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Income or expense ledger entry stored in integer paise minor units.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "amountPaise": {
          "type": "integer",
          "description": "Transaction amount in integer minor units (paise, > 0)."
        },
        "type": {
          "type": "string",
          "description": "Transaction direction.",
          "enum": ["income", "expense"],
          "minLength": 6,
          "maxLength": 7
        },
        "category": {
          "type": "string",
          "description": "Income or expense category name.",
          "minLength": 1,
          "maxLength": 50
        },
        "description": {
          "type": "string",
          "description": "Human-readable transaction note.",
          "minLength": 1,
          "maxLength": 250
        },
        "transactionDate": {
          "type": "string",
          "description": "ISO date YYYY-MM-DD in Asia/Kolkata.",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "month": {
          "type": "integer",
          "description": "Calendar month (1 to 12)."
        },
        "year": {
          "type": "integer",
          "description": "Calendar year (2000 to 2100)."
        },
        "isSample": {
          "type": "boolean",
          "description": "Marks optional sample starter records separately from organic entries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "userId",
        "amountPaise",
        "type",
        "category",
        "description",
        "transactionDate",
        "month",
        "year",
        "isSample",
        "createdAt",
        "updatedAt"
      ]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly spending cap for a specific expense category.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "description": "Expense category name.",
          "minLength": 1,
          "maxLength": 50
        },
        "monthlyLimitPaise": {
          "type": "integer",
          "description": "Monthly budget limit in integer minor units (paise, > 0)."
        },
        "month": {
          "type": "integer",
          "description": "Target month (1 to 12)."
        },
        "year": {
          "type": "integer",
          "description": "Target year (2000 to 2100)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "userId",
        "category",
        "monthlyLimitPaise",
        "month",
        "year",
        "createdAt",
        "updatedAt"
      ]
    },
    "Insight": {
      "title": "Insight",
      "description": "AI-generated financial summary and recommendations grounded in user data.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "period": {
          "type": "string",
          "description": "Analyzed period label (e.g. 2026-11).",
          "minLength": 1,
          "maxLength": 40
        },
        "insightType": {
          "type": "string",
          "description": "Category of insight report.",
          "enum": ["monthly_comprehensive", "spending_alert", "budget_review"],
          "minLength": 1,
          "maxLength": 30
        },
        "summary": {
          "type": "string",
          "description": "Natural-language overview of actual recorded figures.",
          "minLength": 1,
          "maxLength": 2000
        },
        "observations": {
          "type": "array",
          "description": "Up to 10 factual spending observations."
        },
        "unusualSpending": {
          "type": "array",
          "description": "Up to 10 detected spending anomalies compared with history."
        },
        "savingsSuggestions": {
          "type": "array",
          "description": "Up to 10 practical savings suggestions."
        },
        "budgetRecommendations": {
          "type": "array",
          "description": "Up to 10 suggested budget adjustments."
        },
        "disclaimer": {
          "type": "string",
          "description": "Informational disclaimer noting output is not professional financial advice.",
          "minLength": 1,
          "maxLength": 500
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when insight was generated."
        }
      },
      "required": [
        "userId",
        "period",
        "insightType",
        "summary",
        "observations",
        "unusualSpending",
        "savingsSuggestions",
        "budgetRecommendations",
        "disclaimer",
        "generatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores each authenticated user's private profile and UI preferences."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "Stores private income and expense transactions for a specific user."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "Stores monthly category budgets keyed deterministically by YYYY-MM-category."
    },
    "/users/{userId}/insights/{insightId}": {
      "schema": { "$ref": "#/entities/Insight" },
      "description": "Stores generated Gemini AI financial insights history per user."
    }
  }
}
